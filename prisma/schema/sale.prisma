model Sale {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  createdById    String?  @map("created_by_id")
  invoiceNumber  String   @map("invoice_number")
  description    String
  /** Optional display label for the sold item or service line */
  itemName       String?  @map("item_name")
  category       String?  @map("category")
  customerName   String?  @map("customer_name")
  customerId     String?  @map("customer_id")
  amount         Decimal  @db.Decimal(14, 2)
  /** When true, entered amount is gross (VAT included); net is extracted for tax. */
  vatInclusive   Boolean  @default(false) @map("vat_inclusive")
  vatRate        Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 2)
  paymentType    String   @map("payment_type")
  saleDate       DateTime @map("sale_date") @db.Date
  /** Optional due date shown on invoice PDF when payment is by invoice. */
  invoiceDueDate DateTime? @map("invoice_due_date") @db.Date
  /**
   * Structured payments toward this invoice:
   * { total: number, items: [{ amount, paymentType: Cash|Transfer|Card }] }
   * Invariant: total === sum(items[].amount). Drives Invoice payment status.
   */
  invoiceAmountPaid Json @default("{\"total\":0,\"items\":[]}") @map("invoice_amount_paid")
  vatableIncome  Boolean  @default(false) @map("vatable_income")
  serviceIncome  Boolean  @default(true) @map("service_income")
  /**
   * Cash → PAID; Transfer / Card → IN_PROGRESS then PAID via payment-status;
   * Invoice → Pending | Partial | PAID | Overdue, calculated from
   * invoiceAmountPaid.total, totalAmount and invoiceDueDate.
   */
  status         String   @default("Pending")
  documentUrl    String?  @map("document_url")
  /** Optional URL to a payment receipt or supplementary proof (Media upload URL, etc.) */
  receiptUrl     String?  @map("receipt_url")
  evidenceVaultId String? @map("evidence_vault_id")
  /** User bank account (bankCode) used when Transfer/Card payment is confirmed. */
  settlementBankCode String? @map("settlement_bank_code")
  /** Set when Card/Transfer sale is confirmed PAID via payment-status endpoint */
  paymentConfirmedAt DateTime? @map("payment_confirmed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, invoiceNumber])
  @@map("sales")
}
