model Expense {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  createdById   String?  @map("created_by_id")
  expenseNumber String   @unique @map("expense_number")
  description   String
  category      String
  expenseType   String   @default("OPEX") @map("expense_type")
  amount        Decimal  @db.Decimal(14, 2)
  vatInclusive  Boolean  @default(false) @map("vat_inclusive")
  vatAmount     Decimal?  @map("vat_amount") @db.Decimal(14, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)
  paymentType   String   @default("Transfer") @map("payment_type")
  receiptUrl    String?  @map("receipt_url")
  supplierName  String?  @map("supplier_name")
  supplierId    String?  @map("supplier_id")
  expenseDate   DateTime @map("expense_date") @db.Date
  /** Optional invoice / bill due date. */
  invoiceDueDate DateTime? @map("invoice_due_date") @db.Date
  /**
   * Structured payments toward this bill:
   * { total: number, items: [{ amount, paymentType: Cash|Transfer|Card }] }
   * Invariant: total === sum(items[].amount). Drives Invoice payment status.
   */
  invoiceAmountPaid Json @default("{\"total\":0,\"items\":[]}") @map("invoice_amount_paid")
  /**
   * Cash → PAID; Transfer / Card → IN_PROGRESS then PAID via payment-status;
   * Invoice → Pending | Partial | PAID | Overdue, calculated from
   * invoiceAmountPaid.total, totalAmount and invoiceDueDate.
   */
  status        String   @default("IN_PROGRESS")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("expenses")
}
