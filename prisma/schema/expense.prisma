model Expense {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  createdById   String?  @map("created_by_id")
  expenseNumber String   @unique @map("expense_number")
  description   String
  category      String
  amount        Decimal  @db.Decimal(14, 2)
  vatInclusive  Boolean  @default(false) @map("vat_inclusive")
  vatAmount     Decimal?  @map("vat_amount") @db.Decimal(14, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)
  receiptUrl    String?  @map("receipt_url")
  supplierName  String?  @map("supplier_name")
  supplierId    String?  @map("supplier_id")
  expenseDate   DateTime @map("expense_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("expenses")
}
