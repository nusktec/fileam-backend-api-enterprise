model ClientTaxConfiguration {
  id          String   @id @default(uuid())
  companyId   String   @unique @map("company_id")
  vat         Boolean  @default(false) @map("vat")
  paye        Boolean  @default(false) @map("paye")
  wht         Boolean  @default(false) @map("wht")
  cit         Boolean  @default(false) @map("cit")
  stampDuties  Boolean  @default(false) @map("stamp_duties")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("client_tax_configurations")
}
