model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  phone                  String?
  verified               Boolean   @default(false)
  address                String?
  state                  String?
  lga                    String?
  purpose                String?
  roleDescription        String?   @map("role_description")
  /** SOLOPRENEUR | TRADER | PAYEE | GIG_WORKER | REMOTE_WORKER — drives tax guidance UX */
  taxPersona             String?   @map("tax_persona")
  /** NOT_REGISTERED | BUSINESS_NAME | LIMITED_COMPANY — required when taxPersona is SOLOPRENEUR */
  solopreneurRegistration String?  @map("solopreneur_registration")
  /** Total gross employment salary per month (NGN); drives PAYE estimate when persona marks PAYE applicable */
  employmentGrossSalaryMonthly Decimal? @map("employment_gross_salary_monthly") @db.Decimal(14, 2)
  teamSize               Int?
  adminCount             Int?      @map("admin_count")
  organizationName      String?   @map("organization_name")
  organizationAddress    String?   @map("organization_address")
  logo                   String?
  onboardingComplete     Boolean   @default(false) @map("onboarding_complete")
  currentOnboardingStep  String?   @map("current_onboarding_step")
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")
  enterpriseOnboardingComplete Boolean @default(false) @map("enterprise_onboarding_complete")
  enterpriseOnboardingStep    String?   @map("enterprise_onboarding_step")
  filingRemindersEnabled Boolean   @default(true) @map("filing_reminders_enabled")
  payersNotificationsEnabled Boolean @default(true) @map("payers_notifications_enabled")
  complianceUpdatesEnabled Boolean  @default(false) @map("compliance_updates_enabled")
  taxDeadlineEnabled      Boolean   @default(true) @map("tax_deadline_enabled")
  filingConfirmationsEnabled Boolean @default(true) @map("filing_confirmations_enabled")
  weeklySummaryEnabled    Boolean   @default(true) @map("weekly_summary_enabled")
  twoFactorEnabled       Boolean   @default(false) @map("two_factor_enabled")
  requestDelete          Boolean   @default(false) @map("request_delete")
  nextSaleNumber         Int       @default(1) @map("next_sale_number")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tokens                      Token[]
  employees                   Employee[]
  payrollSettings             PayrollSettings?
  payrollObligations          PayrollObligation[]
  userRoles                   UserRole[]
  businesses                  Business[]
  consultantConnections         ConsultantConnection[]
  consultantConnectionsAsConsultant ConsultantConnection[] @relation("ConsultantConnections")
  consultantOnboardingSessions ConsultantOnboardingSession[]
  consultantRequests          Invitation[]              @relation("RequestedUser")
  consultantInvitations       Invitation[]             @relation("ConsultantInvitations")
  ownedCompanies               Company[]                @relation("CompanyOwner")
  linkedCompanies              Company[]                @relation("CompanyLinkedUser")
  sales                       Sale[]
  salesCreated                Sale[]    @relation("SaleCreatedBy")
  expenses                    Expense[]
  expensesCreated             Expense[] @relation("ExpenseCreatedBy")
  taxPayables            TaxPayable[]
  paymentRecords         PaymentRecord[]
  filingDrafts           FilingDraft[]
  vendorPayments         VendorPayment[]
  reports                Report[]
  teamMemberInvitations  TeamMemberInvitation[]  @relation("TeamMemberInvitations")
  teamMemberInvitationAccepted TeamMemberInvitation[] @relation("TeamMemberInvitationAccepted")
  consultantTeamMembers  ConsultantTeamMember[]   @relation("ConsultantTeamMembers")
  consultantTeamMemberOf ConsultantTeamMember[]    @relation("ConsultantTeamMemberOf")
  inventoryItems         InventoryItem[]
  inventorySales         InventorySale[]
  inventoryMovements     InventoryMovement[]
  assets                 Asset[]
  assetsAssignedAsConsultant Asset[] @relation("AssetAssignedConsultant")
  assetTransfers         AssetTransfer[]
  assetSales             AssetSale[]
  assetDisposals         AssetDisposal[]
  assetHistories         AssetHistory[]
  evidenceVaultDocuments EvidenceVaultDocument[]
}
