model TaxPayable {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  taxType          String    @map("tax_type")
  periodYear       Int       @map("period_year")
  periodMonth      Int       @map("period_month")
  amountDue        Decimal   @map("amount_due") @db.Decimal(14, 2)
  penalties        Decimal   @default(0) @map("penalties") @db.Decimal(14, 2)
  totalPayable     Decimal   @map("total_payable") @db.Decimal(14, 2)
  filingDueDate    DateTime  @map("filing_due_date") @db.Date
  status           String    @default("pending")
  currency         String    @default("NGN")
  submittedAt      DateTime? @map("submitted_at")
  documentUrl      String?   @map("document_url")
  evidenceVaultId  String?   @map("evidence_vault_id")
  stateOfOperation String?  @map("state_of_operation")
  vatRegistrationNumber String? @map("vat_registration_number")
  tin              String?
  rcNumber         String?   @map("rc_number")
  companyName      String?   @map("company_name")
  stateOfResidence String?   @map("state_of_residence")
  paymentStatus    String?   @map("payment_status")
  computation      Json?     @db.JsonB
  receiptUrl       String?   @map("receipt_url")
  paymentLink      String?   @map("payment_link")
  currentStep            Int       @default(1) @map("current_step")
  completedSteps         Json      @default("[]") @map("completed_steps")
  frozen                 Boolean   @default(false)
  frozenAt               DateTime? @map("frozen_at")
  draftInputs            Json?     @map("draft_inputs")
  validation             Json?     @db.JsonB
  acknowledgedGaps       Boolean   @default(false) @map("acknowledged_gaps")
  reviewedDocumentIds    Json      @default("[]") @map("reviewed_document_ids")
  submissionReference    String?   @map("submission_reference")
  rrr                    String?
  submissionProofName    String?   @map("submission_proof_name")
  submissionProofUrl     String?   @map("submission_proof_url")
  paymentReceiptName     String?   @map("payment_receipt_name")
  paymentReceiptUrl      String?   @map("payment_receipt_url")
  formsGenerated         Boolean   @default(false) @map("forms_generated")
  packageUrl             String?   @map("package_url")
  packageExpiresAt       DateTime? @map("package_expires_at")
  portalOpenedAt         DateTime? @map("portal_opened_at")
  priorPeriodCarry       Json?     @map("prior_period_carry")
  booksChangedSinceFreeze Boolean  @default(false) @map("books_changed_since_freeze")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  PaymentRecord[]
  timeline  FilingTimelineEvent[]
  documents FilingDocument[]

  @@unique([userId, taxType, periodYear, periodMonth])
  @@map("tax_payables")
}
