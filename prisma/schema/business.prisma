model Business {
  id                                String   @id @default(uuid())
  userId                            String   @map("user_id")
  name                              String
  incomeType                        String   @map("income_type")
  taxObligationsUnderstoodAndAccepted Boolean @default(false) @map("tax_obligations_understood_and_accepted")
  businessIdNumber                  String?  @map("business_id_number")
  rcNumber                           String?  @map("rc_number")
  businessType                      String?  @map("business_type")
  sector                             String?  @map("sector")
  totalFixedAssets                   Decimal? @map("total_fixed_assets") @db.Decimal(14, 2)
  annualGrossTurnover                Decimal? @map("annual_gross_turnover") @db.Decimal(14, 2)
  providesProfessionalServices       String?  @map("provides_professional_services")
  primaryBusinessActivity            String?  @map("primary_business_activity")
  bankAccount                        String?  @map("bank_account")
  tin                               String?  @map("tin")
  streetAddress                     String?  @map("street_address")
  stateOfResidence                  String?  @map("state_of_residence")
  primaryTaxOffice                  String?  @map("primary_tax_office")
  city                              String?  @map("city")
  website                           String?  @map("website")
  contactEmail                      String?  @map("contact_email")
  turnoverBand                      String?  @map("turnover_band")
  vatStatus                         String?  @map("vat_status")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("businesses")
}
