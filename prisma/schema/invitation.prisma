enum InvitationStatus {
  pending
  accepted
  rejected
}

enum InvitationInitiator {
  consultant_to_client
  client_to_consultant
}

model Invitation {
  id                    String           @id @default(uuid())
  code                  String           @unique
  consultantUserId      String           @map("consultant_user_id")
  requestedUserId       String?          @map("requested_user_id")
  initiator             InvitationInitiator @default(consultant_to_client) @map("initiator")
  invitedEmail          String           @map("invited_email")
  invitedBusinessName   String?          @map("invited_business_name")
  invitedContactName    String?          @map("invited_contact_name")
  invitedRcNumber       String?          @map("invited_rc_number")
  invitedPhone          String?          @map("invited_phone")
  stateOfOperation      String?          @map("state_of_operation")
  taxTypesManaged       String?          @map("tax_types_managed")
  status                InvitationStatus @default(pending)
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  consultantUser        User                 @relation("ConsultantInvitations", fields: [consultantUserId], references: [id], onDelete: Cascade)
  requestedUser         User?                @relation("RequestedUser", fields: [requestedUserId], references: [id], onDelete: Cascade)
  consultantConnections ConsultantConnection[]

  @@index([requestedUserId])
  @@map("invitations")
}
