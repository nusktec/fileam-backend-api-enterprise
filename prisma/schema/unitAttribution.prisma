model UnitAttribution {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  assetId           String   @unique @map("asset_id")
  productName       String   @map("product_name")
  brandName         String?  @map("brand_name")
  skuCode           String?  @map("sku_code")
  description       String?
  unitOfMeasurement String   @map("unit_of_measurement")
  periodType        String   @map("period_type")
  administratorName String?  @map("administrator_name")
  factoryPlantName  String?  @map("factory_plant_name")
  department        String?
  branchLocation    String?  @map("branch_location")
  /** live | voided | reversed */
  status            String    @default("live")
  undoAt            DateTime? @map("undo_at")
  undoReason        String?   @map("undo_reason")
  reversingEntryId  String?   @map("reversing_entry_id")
  reversingEntryDate DateTime? @map("reversing_entry_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset   Asset                       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  records UnitAttributionProductionRecord[]

  @@index([userId])
  @@index([userId, status])
  @@map("unit_attributions")
}

model UnitAttributionProductionRecord {
  id                String   @id @default(uuid())
  unitAttributionId String   @map("unit_attribution_id")
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  periodLabel       String   @map("period_label")
  unitsAttributed   Int      @map("units_attributed")
  /** RECORDED | voided | reversed (OPEN is generated, not persisted) */
  status            String   @default("RECORDED")
  undoAt            DateTime? @map("undo_at")
  undoReason        String?   @map("undo_reason")
  reversingEntryId  String?   @map("reversing_entry_id")
  reversingEntryDate DateTime? @map("reversing_entry_date") @db.Date
  unitCost          Decimal? @map("unit_cost") @db.Decimal(14, 2)
  batchLotNumber    String?  @map("batch_lot_number")
  productionLine    String?  @map("production_line")
  shift             String?
  locationWarehouse String?  @map("location_warehouse")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  unitAttribution UnitAttribution @relation(fields: [unitAttributionId], references: [id], onDelete: Cascade)

  @@unique([unitAttributionId, periodStart], map: "uap_records_attribution_period_uniq")
  @@map("unit_attribution_production_records")
}
