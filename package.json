{
  "name": "file-am",
  "version": "1.0.0",
  "description": "fintech-api",
  "main": "dist/app.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "ts-node src/seed/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:rollback": "prisma migrate resolve --rolled-back 20260312105438_add_invitation_and_connection_status_enums --schema=prisma/schema",
    "prisma:studio": "prisma studio",
    "db:setup": "pnpm run prisma:migrate && pnpm run seed",
    "docker:build": "docker build -t file-am .",
    "docker:run": "docker run -p 3000:80 --env-file .env file-am",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:postman": "newman run postman/Fileam-API.postman_collection.json"
  },
  "keywords": [
    "bank",
    "fintech",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.873.0",
    "@prisma/client": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/nodemon": "^1.19.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "prisma": "^6.0.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.17",
    "@types/sequelize": "^4.28.20",
    "newman": "^6.2.2",
    "ts-node-dev": "^2.0.0"
  }
}
