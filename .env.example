# App
NODE_ENV=development
API_VERSION=1
PORT=5000
BASE_URL=http://localhost:3000

# Database (PostgreSQL) – required for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=file-am
SMTP_REPLY_TO=support@example.com

# Cloudflare R2 Object Storage (S3-compatible)
# Create API token: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Account ID: Cloudflare Dashboard → right sidebar or URL
# Public URL: Enable "Allow Access" on bucket → use r2.dev subdomain or custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Payment webhook (third-party provider calls to record payments)
PAYMENT_WEBHOOK_SECRET=

# AI Service (server-to-server API for external AI to pull/update client records)
AI_SERVICE_SECRET=your-ai-service-secret-change-in-production

# Optional
DEBUG=false
RUN_SEED=true
ALLOWED_ORIGINS=http://localhost:3000
