<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client connection request - Fileam</title>
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; margin: 0; padding: 0; overflow-x: hidden; -webkit-text-size-adjust: 100%; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; background-color: #f5f5f5; color: #1a1a1a; line-height: 1.6; margin: 0; padding: 24px; }
        .container { max-width: 560px; width: 100%; margin: 0 auto; background-color: #ffffff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); overflow: hidden; }
        @media only screen and (max-width: 600px) { body { padding: 12px !important; } .header, .content, .footer { padding: 24px 16px !important; } .btn { display: block !important; width: 100% !important; max-width: 280px !important; margin: 10px auto !important; } }
        .header { background-color: #ffffff; padding: 40px 32px; text-align: center; border-bottom: 1px solid #e9ecef; }
        .logo { display: block; margin: 0 auto 16px; max-height: 48px; width: auto; }
        .content { padding: 40px 32px; }
        .greeting { font-size: 22px; font-weight: 700; color: #1a1a1a; margin-bottom: 16px; }
        .message { font-size: 15px; color: #4a4a4a; margin-bottom: 24px; line-height: 1.65; }
        .buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin: 28px 0; }
        .btn { display: inline-block; padding: 14px 32px; border-radius: 10px; font-size: 16px; font-weight: 600; text-decoration: none; text-align: center; }
        .btn-accept { background-color: #008b8b; color: #ffffff !important; }
        .btn-decline { background-color: #6c757d; color: #ffffff !important; }
        .expiry-info { background-color: #fff8e6; border: 1px solid #f59e0b; border-radius: 10px; padding: 14px; margin: 20px 0; text-align: center; }
        .expiry-text { color: #92400e; font-size: 14px; font-weight: 500; }
        .footer { background-color: #f8f9fa; padding: 28px 32px; text-align: center; border-top: 1px solid #e9ecef; }
        .footer-text { color: #6c757d; font-size: 13px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://usc1.contabostorage.com/385b0054b385440e928060e34f0e5b18:fileam-assets/fileam-logo.png" alt="Fileam" class="logo" width="140" height="48">
        </div>
        <div class="content">
            <div class="greeting">Hello {{name}}!</div>
            <div class="message">{{clientName}} would like to connect with you on Fileam so you can support their tax compliance. Accept or decline below.</div>
            <div class="buttons">
                <a href="{{acceptUrl}}" class="btn btn-accept">Accept</a>
                <a href="{{declineUrl}}" class="btn btn-decline">Decline</a>
            </div>
            <div class="expiry-info"><div class="expiry-text">This request expires on {{expiryDate}}</div></div>
            <div class="message"><p>Best regards,<br>The Fileam Team</p></div>
        </div>
        <div class="footer">
            <div class="footer-text">&copy; Fileam. <a href="https://fileam.app">fileam.app</a></div>
        </div>
    </div>
</body>
</html>
