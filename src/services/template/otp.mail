<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your secure access code - Fileam</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; background-color: #f5f5f5; color: #1a1a1a; line-height: 1.6; margin: 0; padding: 24px; }
        .container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); overflow: hidden; }
        .header { background-color: #ffffff; padding: 40px 32px; text-align: center; border-bottom: 1px solid #e9ecef; }
        .logo { display: block; margin: 0 auto 16px; max-height: 48px; width: auto; }
        .header-subtitle { font-size: 15px; color: #6c757d; font-weight: 400; }
        .content { padding: 40px 32px; }
        .greeting { font-size: 22px; font-weight: 700; color: #1a1a1a; margin-bottom: 16px; }
        .message { font-size: 15px; color: #4a4a4a; margin-bottom: 24px; line-height: 1.65; }
        .otp-container { background: #f8f9fa; border-radius: 12px; padding: 28px; text-align: center; margin: 28px 0; border: 1px solid #e9ecef; }
        .otp-label { font-size: 12px; color: #6c757d; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .otp-code { font-size: 42px; font-weight: bold; color: #1a1a1a; letter-spacing: 10px; font-family: 'Courier New', monospace; background: #fff; padding: 18px 28px; border-radius: 10px; border: 2px solid #008b8b; display: inline-block; min-width: 260px; }
        .expiry-info { background-color: #fff8e6; border: 1px solid #f59e0b; border-radius: 10px; padding: 14px; margin: 20px 0; text-align: center; }
        .expiry-text { color: #92400e; font-size: 14px; font-weight: 500; }
        .cta-note { background-color: #e6f7f7; border-radius: 10px; padding: 16px; margin: 20px 0; border-left: 4px solid #008b8b; }
        .cta-note .security-text { color: #004d4d; font-size: 14px; margin: 0; }
        .footer { background-color: #f8f9fa; padding: 28px 32px; text-align: center; border-top: 1px solid #e9ecef; }
        .footer-text { color: #6c757d; font-size: 13px; margin-bottom: 8px; }
        .footer a { color: #008b8b; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://usc1.contabostorage.com/385b0054b385440e928060e34f0e5b18:fileam-assets/fileam-logo.png" alt="Fileam" class="logo" width="140" height="48">
            <div class="header-subtitle">Secure access code</div>
        </div>
        <div class="content">
            <div class="greeting">Hello {{name}}!</div>
            <div class="message">You requested a one-time password (OTP) for Fileam. Use the code below to complete your action.</div>
            <div class="otp-container">
                <div class="otp-label">Your secure access code</div>
                <div class="otp-code">{{otpCode}}</div>
            </div>
            <div class="expiry-info"><div class="expiry-text">This code expires in 10 minutes</div></div>
            <div class="cta-note">
                <p class="security-text">Do not share this code. Fileam will never ask for it by phone or email.</p>
            </div>
        </div>
        <div class="footer">
            <div class="footer-text">&copy; Fileam. All rights reserved. <a href="https://fileam.app">fileam.app</a></div>
        </div>
    </div>
</body>
</html>
