NODE_ENV=development
DEBUG=true
API_VERSION=1
PORT=4000
BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/file_am?schema=public"

JWT_SECRET=your-jwt-secret-min-32-chars

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@file-am.com
SMTP_FROM_NAME=file-am
SMTP_REPLY_TO=support@file-am.com
# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

ALLOWED_ORIGINS=http://localhost:3000

# Mobile app version / forced update (GET /mobile/app/version)
MOBILE_IOS_MIN_VERSION=1.0.0
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_STORE_URL=
MOBILE_FORCE_UPDATE_MESSAGE=Please update Fileam to the latest version to continue.
MOBILE_SOFT_UPDATE_MESSAGE=A new version of Fileam is available. Update for the best experience.
