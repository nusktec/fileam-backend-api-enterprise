{
  "info": {
    "name": "file-am API",
    "description": "file-am API: Mobile (auth, user, onboarding, sales, expenses, tax computation, tax payables, payments), Webhooks (payment confirmation), Enterprise (health, company, invitation, onboarding). Sign up via onboarding only (no register endpoint). Payment is handled by a third party; use tax-payables and payments to list due amounts and track payment records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "apiVersion", "value": "1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "onboardingToken", "value": "" },
    { "key": "webhookSecret", "value": "" }
  ],
  "item": [
    {
      "name": "Mobile",
      "description": "Mobile app endpoints. Auth: OTP, login, refresh, logout (no register; use Onboarding to sign up). User, Onboarding, Sales, Expenses, Tax Computation, Tax Payables, Payments require auth + completed onboarding where noted.",
      "item": [
        {
          "name": "Auth",
          "description": "OTP email verification, login, token refresh, logout. Registration is via Onboarding only.",
          "item": [
            {
              "name": "Send OTP to email",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/otp/send/email",
                "description": "Sends OTP to the given email. Body: email (required)."
              }
            },
            {
              "name": "Verify OTP",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/otp/verify/email",
                "description": "Verifies OTP and marks email verified. Body: email, code (required)."
              }
            },
            {
              "name": "Resend verification email",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/resend-verification",
                "description": "Resends verification email. Body: email (required)."
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/login",
                "description": "Returns accessToken, refreshToken, user. If onboarding incomplete, also returns onboardingToken and currentOnboardingStep."
              }
            },
            {
              "name": "Refresh token",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/refresh",
                "description": "Returns new accessToken. Body: refreshToken (required)."
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/logout",
                "description": "Revokes the refresh token. Body: refreshToken (required)."
              }
            }
          ]
        },
        {
          "name": "User",
          "description": "Profile and password. Requires authentication and completed onboarding.",
          "item": [
            {
              "name": "Get profile",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/profile",
                "description": "Returns current user profile (id, email, firstName, lastName, role, etc.)."
              }
            },
            {
              "name": "Update profile",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"address\": \"\",\n  \"state\": \"\",\n  \"organizationName\": \"\",\n  \"organizationAddress\": \"\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/profile",
                "description": "Updates profile. Body: firstName, lastName, address, state, organizationName, organizationAddress, logo (all optional)."
              }
            },
            {
              "name": "Change password",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"oldpassword123\",\n  \"newPassword\": \"newpassword123\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/password",
                "description": "Changes password. Body: currentPassword, newPassword (required)."
              }
            }
          ]
        },
        {
          "name": "Onboarding",
          "description": "Business sign-up flow: email (OTP), email-verify (returns onboarding token), password, income-type, tax-obligations, business-details, tax-jurisdiction, consultant-terms. Invite: verify-code, accept-request, reject-request. Use onboarding token in Authorization header for steps after email-verify.",
          "item": [
            {
              "name": "Get profile (onboarding token)",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/profile"
              }
            },
            {
              "name": "Step - Email (send OTP)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"firstName\": \"New\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/email"
              }
            },
            {
              "name": "Step - Email verify (get onboarding token)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"code\": \"123456\",\n  \"invitationId\": \"\",\n  \"companyId\": \"\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/email-verify"
              }
            },
            {
              "name": "Step - Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"password\": \"password123\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/password"
              }
            },
            {
              "name": "Step - Income type",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"incomeType\": \"business\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/income-type"
              }
            },
            {
              "name": "Step - Tax obligations",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/tax-obligations"
              }
            },
            {
              "name": "Step - Business details",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"My Business Ltd\",\n  \"businessIdNumber\": \"\",\n  \"tin\": \"\",\n  \"streetAddress\": \"123 Main St\",\n  \"stateOfResidence\": \"Lagos\",\n  \"primaryTaxOffice\": \"\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/business-details"
              }
            },
            {
              "name": "Step - Tax jurisdiction",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"primaryTaxOffice\": \"\",\n  \"stateOfResidence\": \"Lagos\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/tax-jurisdiction"
              }
            },
            {
              "name": "Step - Consultant terms (complete)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/consultant-terms"
              }
            },
            {
              "name": "Invite - Verify code",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/invite/verify-code"
              }
            },
            {
              "name": "Invite - Accept request",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"invitationId\": \"<invitation-uuid>\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/invite/accept-request"
              }
            },
            {
              "name": "Invite - Reject request",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{onboardingToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"invitationId\": \"<invitation-uuid>\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/invite/reject-request"
              }
            }
          ]
        },
        {
          "name": "Sales",
          "description": "Track revenue and invoices. Requires authentication and completed onboarding. Invoice IDs (e.g. INV-001) are auto-generated by the server.",
          "item": [
            {
              "name": "List sales",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales?status=all",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "sales"],
                  "query": [{ "key": "status", "value": "all", "description": "Filter: all | Paid | Pending | Overdue" }]
                },
                "description": "Returns sales list with summary (totalIncome, vatCollected), counts (all, paid, pending, overdue), and sales array."
              }
            },
            {
              "name": "Get sale by ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales/:id",
                "description": "Returns a single sale with full details and amount breakdown (baseAmount, vatRate, vatAmount, total). Path param: id (sale UUID)."
              }
            },
            {
              "name": "Add sale",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 20000,\n  \"description\": \"Web Development Services\",\n  \"customerName\": \"Victor Asuquo\",\n  \"paymentType\": \"Transfer\",\n  \"date\": \"2026-02-08\",\n  \"vatableIncome\": true,\n  \"serviceIncome\": true\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales",
                "description": "Creates a sale. Invoice number (e.g. INV-001) is auto-generated. Body: amount (number, required), description (string, required), customerName (string, optional), paymentType (required: Cash | Transfer | Invoice | Card), date (ISO date, required), vatableIncome (boolean, default false), serviceIncome (boolean, default true). VAT 7.5% applied when vatableIncome is true."
              }
            }
          ]
        },
        {
          "name": "Expenses",
          "description": "Track business costs and receipts. Requires authentication and completed onboarding. Expense IDs (e.g. EXP-001) are auto-generated by the server.",
          "item": [
            {
              "name": "List expenses",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/expenses",
                "description": "Returns expenses list with summary (totalExpenses, vatClaimable), topCategories (category, amount, percentageOfTotal), and expenses array."
              }
            },
            {
              "name": "Get expense by ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/expenses/:id",
                "description": "Returns a single expense with full details and amount breakdown. Path param: id (expense UUID)."
              }
            },
            {
              "name": "Add expense",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 150000,\n  \"description\": \"Office rent - February\",\n  \"category\": \"Rent\",\n  \"date\": \"2026-02-08\",\n  \"vatInclusive\": false,\n  \"receiptUrl\": null\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/expenses",
                "description": "Creates an expense. Expense number (e.g. EXP-001) is auto-generated. Body: amount (number, required), description (string, required), category (required: Rent | Tools & Software | Marketing | Internet | Other), date (ISO date, required), vatInclusive (boolean, optional), vatAmount (number, optional), receiptUrl (string, optional)."
              }
            }
          ]
        },
        {
          "name": "Tax Computation",
          "description": "Real-time tax calculations (VAT, WHT, CIT) based on sales and expenses for a given period. Requires authentication and completed onboarding.",
          "item": [
            {
              "name": "Get tax computation",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/tax-computation?period=2026-02",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "tax-computation"],
                  "query": [{ "key": "period", "value": "2026-02", "description": "Optional. YYYY-MM (e.g. 2026-02). Default: current month." }]
                },
                "description": "Returns period overview (totalIncome, totalExpenses, netProfit), VAT (outputVat, inputVatClaimable, netVatPayable, threshold info), WHT (serviceIncome, estimatedWhtDeducted), CIT (monthlyProfit, annualizedProfit, estimatedAnnualCit, threshold info)."
              }
            }
          ]
        },
        {
          "name": "Tax Payables",
          "description": "List of due tax payments (VAT, WHT, CIT) derived from monthly tax computation. Status: pending, paid, overpaid, partially_paid.",
          "item": [
            {
              "name": "List tax payables",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/tax-payables?status=pending&taxType=VAT",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "tax-payables"],
                  "query": [
                    { "key": "status", "value": "pending", "description": "Filter: pending | paid | overpaid | partially_paid" },
                    { "key": "taxType", "value": "VAT", "description": "Filter: VAT | WHT | CIT" }
                  ]
                },
                "description": "Syncs payables from tax computation (last 12 months) then returns list. Each item: id, taxType, periodLabel, amountDue, penalties, totalPayable, filingDueDate, status, totalPaid."
              }
            },
            {
              "name": "Get tax payable by ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/tax-payables/:id",
                "description": "Returns one payable with payment history (payments array)."
              }
            },
            {
              "name": "Initiate payment",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"card\"\n}"
                },
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/tax-payables/:id/initiate-payment",
                "description": "Stub: returns reference and amount for third-party integration. Body: method (card | bank_transfer | cash). Actual payment is done externally; then call webhook to record result."
              }
            }
          ]
        },
        {
          "name": "Payments",
          "description": "Payment history (records from third-party payment). Track which payables are paid, pending, or overpaid.",
          "item": [
            {
              "name": "List payment history",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/payments",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "payments"],
                  "query": [
                    { "key": "taxPayableId", "value": "", "description": "Optional. Filter by tax payable UUID." },
                    { "key": "status", "value": "completed", "description": "Optional. Filter: completed | pending | failed" }
                  ]
                },
                "description": "Returns payment records for the user (amountPaid, method, status, paidAt, taxType, periodLabel)."
              }
            },
            {
              "name": "Get payment record by ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/payments/:id",
                "description": "Returns one payment record with payable details."
              }
            }
          ]
        },
        {
          "name": "Filings",
          "description": "Filings overview (VAT/WHT by period), detail with timeline, document/vault links. VAT: calculation, draft, submit. WHT: schedule, draft, submit.",
          "item": [
            {
              "name": "List filings",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/filings?status=all&taxType=VAT",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "filings"],
                  "query": [
                    { "key": "status", "value": "all", "description": "Filter: all | overdue | submitted | paid" },
                    { "key": "taxType", "value": "VAT", "description": "Optional. VAT | WHT" }
                  ]
                },
                "description": "Returns filings list: id, taxType, periodLabel, amount, status (overdue/submitted/paid/pending), dueDate, submittedDate."
              }
            },
            {
              "name": "Get filing by ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/filings/:id",
                "description": "Returns filing detail with timeline (Draft Created, Reviewed, Submitted to FIRS, Payment Confirmed), documentUrl, evidenceVaultId, receiptUrl, stateOfOperation, vatRegistrationNumber."
              }
            },
            {
              "name": "Get filing document URL",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/filings/:id/document",
                "description": "Returns document URL for download."
              }
            },
            {
              "name": "Get filing vault link",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/filings/:id/vault-link",
                "description": "Returns evidenceVaultId for View in Vault."
              }
            },
            {
              "name": "VAT - Get calculation",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v{{apiVersion}}/mobile/filings/vat/calculation?period=2026-01",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v{{apiVersion}}", "mobile", "filings", "vat", "calculation"],
                  "query": [{ "key": "period", "value": "2026-01", "description": "YYYY-MM" }]
                },
                "description": "Returns VAT calculation: period, stateOfOperation, vatRegistrationNumber (from draft if any), outputVat, inputVatClaimable, netVatPayable, breakdown."
              }
            },
            {
              "name": "VAT - Create/update draft",
              "request": {
                "method": "POST",
                "header": [
