    {
      "name": "Webhooks",
      "description": "Called by third-party payment provider to record payment results. Secure with X-Webhook-Secret or PAYMENT_WEBHOOK_SECRET.",
      "item": [
        {
          "name": "Payment confirmation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Webhook-Secret", "value": "{{webhookSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taxPayableId\": \"<tax-payable-uuid>\",\n  \"userId\": \"<user-uuid>\",\n  \"amountPaid\": 109273,\n  \"externalReference\": \"TXN-12345\",\n  \"externalPaymentId\": \"ext-pay-id\",\n  \"method\": \"bank_transfer\",\n  \"status\": \"completed\",\n  \"paidAt\": \"2026-02-21T10:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/v{{apiVersion}}/webhooks/payment",
            "description": "Creates a payment record and updates TaxPayable status (pending/paid/overpaid). Idempotent by externalReference. Required: taxPayableId, userId, amountPaid. Optional: externalReference, externalPaymentId, method, status, paidAt, metadata."
          }
        }
      ]
    },
