            {"name": "Accept", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/consultant-requests/{{invitationId}}/accept"}},
            {"name": "Decline", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/consultant-requests/{{invitationId}}/decline"}}
          ]
        },
        {
          "name": "Onboarding",
