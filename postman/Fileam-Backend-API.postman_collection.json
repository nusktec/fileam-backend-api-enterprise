            {"name": "Change password", "request": {"method": "PATCH", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"currentPassword\":\"Password123!\",\"newPassword\":\"NewPass456!\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/password"}},
            {"name": "Get business profile", "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/business-profile"}},
            {"name": "Update business profile", "request": {"method": "PUT", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"businessName\":\"Acme Ltd\",\"tin\":\"12345678-0001\",\"rcNumber\":\"RC1234567\",\"address\":\"123 Main St\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/business-profile"}},
            {"name": "Get notification settings", "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/notification-settings"}},
            {"name": "Update notification settings", "request": {"method": "PUT", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"taxDeadline\":true,\"filingConfirmations\":true,\"weeklySummary\":true,\"filingReminders\":true,\"payersNotifications\":true,\"complianceUpdates\":false,\"twoFactorEnabled\":false}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/notification-settings"}},
            {"name": "Get consultant", "event": [{"listen": "test", "script": {"exec": ["var j=pm.response.json(); if(j.status&&j.data&&j.data.id){pm.collectionVariables.set('connectionId',j.data.id);}"], "type": "text/javascript"}}], "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/consultant"}},
            {"name": "Revoke consultant", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"connectionId\":\"{{connectionId}}\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/consultant/revoke"}},
            {"name": "Contacts and types", "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/contacts-and-types"}}
