            {"name": "Create expense (Marketing)", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"description\":\"Google Ads\",\"amount\":25000,\"date\":\"2026-02-21\",\"category\":\"Marketing\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/expenses"}}
