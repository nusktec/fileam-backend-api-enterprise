            {"name": "Get profile", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Bearer {{onboardingToken}}"}], "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/profile"}},
            {"name": "Step - Email", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\",\"firstName\":\"Jane\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/email"}},
            {"name": "Step - Email resend", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\",\"firstName\":\"Jane\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/email-resend"}},
            {"name": "Step - Email verify", "event": [{"listen": "test", "script": {"exec": ["var j=pm.response.json(); if(j.status&&j.data&&j.data.onboardingToken){pm.collectionVariables.set('onboardingToken',j.data.onboardingToken);}"], "type": "text/javascript"}}], "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\",\"code\":\"123456\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/email-verify"}},
            {"name": "Step - Password", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"},{"key": "Authorization","value": "Bearer {{onboardingToken}}"}], "body": {"mode": "raw", "raw": "{\"password\":\"password123\",\"firstName\":\"Jane\",\"lastName\":\"Doe\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/password"}},
