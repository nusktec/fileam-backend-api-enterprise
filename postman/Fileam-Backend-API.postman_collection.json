            {"name": "Create sale (Product Sales)", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"description\":\"Product sale\",\"amount\":75000,\"date\":\"2026-02-21\",\"paymentType\":\"Transfer\",\"customerName\":\"Retail Co\",\"category\":\"Product Sales\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales"}}
