{
  "info": {
    "name": "Fileam Backend API",
    "description": "Fileam Backend API v1. Base: {{baseUrl}}/api/v{{apiVersion}}. Auth: Bearer {{accessToken}}. Upload files via Media first, then use returned URL in other endpoints. Expense categories: Rent, Tools & Software, Marketing, Internet, Salary, Other. Sale categories: Consulting, Product Sales, Service Income, Subscription, Other. Employment types: Part time, Full time, Contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "apiVersion", "value": "1" },
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "clientId", "value": "" },
    { "key": "connectionId", "value": "" },
    { "key": "consultantOnboardingToken", "value": "" },
    { "key": "enterpriseOnboardingToken", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "filingId", "value": "" },
    { "key": "invitationCode", "value": "" },
    { "key": "invitationId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "mediaKey", "value": "path/to/file" },
    { "key": "onboardingToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "requestedUserId", "value": "" },
    { "key": "saleId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "payableId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "vaultDocId", "value": "" },
    { "key": "webhookSecret", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('accessToken');",
          "if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "const method = pm.request.method;",
          "if (['POST','PUT','PATCH','DELETE'].includes(method) && pm.request.body?.mode === 'raw') {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Mobile",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "event": [{"listen": "test", "script": {"exec": ["var j=pm.response.json(); if(j.status&&j.data){if(j.data.accessToken)pm.collectionVariables.set('accessToken',j.data.accessToken);if(j.data.refreshToken)pm.collectionVariables.set('refreshToken',j.data.refreshToken);if(j.data.onboardingToken)pm.collectionVariables.set('onboardingToken',j.data.onboardingToken);}"], "type": "text/javascript"}}],
              "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"consultant@fileam.app\",\"password\":\"Password123!\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/login"}
            },
            {"name": "Forgot password", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/forgot-password"}},
            {"name": "Resend forgot password", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/forgot-password/resend"}},
            {"name": "Reset password", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"user@example.com\",\"code\":\"123456\",\"newPassword\":\"newpass123\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/reset-password"}},
            {"name": "Refresh token", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/refresh"}},
            {"name": "Logout", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/auth/logout"}}
          ]
        },
        {
          "name": "User",
          "item": [
            {"name": "Get profile", "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/user/profile"}},
