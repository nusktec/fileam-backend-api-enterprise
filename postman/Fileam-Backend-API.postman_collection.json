            {"name": "Invite - Accept request", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"invitationId\":\"{{invitationId}}\",\"invitationCode\":\"{{invitationCode}}\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/invite/accept-request"}},
            {"name": "Invite - Reject request", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"invitationId\":\"{{invitationId}}\",\"invitationCode\":\"{{invitationCode}}\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/invite/reject-request"}}
          ]
        },
        {
          "name": "Sales",
          "item": [
            {"name": "List sales", "event": [{"listen": "test", "script": {"exec": ["var j=pm.response.json(); var d=j.data; var arr=d&&d.sales?d.sales:d&&Array.isArray(d)?d:[]; if(j.status&&arr.length&&arr[0].id){pm.collectionVariables.set('saleId',arr[0].id);}"], "type": "text/javascript"}}], "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales?page=1&limit=20"}},
            {"name": "Get sale", "request": {"method": "GET", "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/sales/{{saleId}}"}},
