            {"name": "Step - Business details", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"businessName\":\"Acme\",\"businessType\":\"Business\",\"tin\":\"12345678-0001\",\"rcNumber\":\"RC1234567\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/business-details"}},
            {"name": "Step - Tax jurisdiction", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"state\":\"Lagos\",\"lga\":\"Ikeja\"}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/tax-jurisdiction"}},
            {"name": "Step - Consultant terms", "request": {"method": "POST", "header": [{"key": "Content-Type","value": "application/json"}], "body": {"mode": "raw", "raw": "{\"accepted\":true}"}, "url": "{{baseUrl}}/api/v{{apiVersion}}/mobile/onboarding/step/consultant-terms"}},
